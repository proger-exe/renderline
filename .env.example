# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Postgres (defaults match compose.yaml)
DATABASE_URL=postgresql+asyncpg://renderline:renderline@postgres:5432/renderline
DATABASE_URL_SYNC=postgresql://renderline:renderline@postgres:5432/renderline

# RabbitMQ
RABBITMQ_URL=amqp://renderline:renderline@rabbitmq:5672/
RABBITMQ_QUEUE=render_tasks

# Storage (shared volume between api, bot and worker)
STORAGE_PATH=./storage
STORAGE_ASSETS_PATH=./storage/assets
STORAGE_AUDIO_PATH=./storage/audio
STORAGE_OUTPUT_PATH=./storage/output

API_HOST=0.0.0.0
API_PORT=8000
WORKER_CONCURRENCY=2
